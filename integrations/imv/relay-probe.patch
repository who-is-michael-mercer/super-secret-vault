diff --git i/src/relay_probe.h w/src/relay_probe.h
new file mode 100644
index 0000000..e076ae9
--- /dev/null
+++ w/src/relay_probe.h
@@ -0,0 +1,104 @@
+/* Development-only Relay feasibility probe. No launcher, device reads or logs.
+ * stdout contains state and aggregate counts for eight named test keys only. */
+#ifndef RELAY_PROBE_H
+#define RELAY_PROBE_H
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <linux/input-event-codes.h>
+
+
+struct relay_pose {
+  int x, y, iw, ih, ww, wh, bw, bh;
+  double zoom, rotation;
+  bool mirror, focus, file_ok, loading;
+  unsigned generation;
+};
+struct relay_probe {
+  struct relay_pose last;
+  const char *target;
+  double region[8]; /* x y w h zoom-min zoom-max x/y-tolerance */
+  bool initialized, configured, focus, have_last;
+  unsigned generation, prefix, matches, resets;
+  double last_press;
+  unsigned counts[8][3]; /* aggregate release / press / repeat */
+};
+static const int relay_codes[] = {
+  KEY_HOME, KEY_F7, KEY_END, KEY_PAUSE, KEY_PAGEUP, KEY_CAPSLOCK, KEY_ESC, KEY_INSERT
+};
+static const char *relay_names[] = {
+  "HOME", "F7", "END", "PAUSE", "PGUP", "CAPSLOCK", "ESC", "INSERT"
+};
+static const int relay_sequence[] = {
+  KEY_HOME, KEY_F7, KEY_END, KEY_PAUSE, KEY_PAGEUP, KEY_CAPSLOCK, KEY_ESC, KEY_HOME
+};
+
+static void relay_reset(struct relay_probe *p)
+{
+  if (p->prefix) ++p->resets;
+  p->prefix = 0;
+}
+/* Shared by the real viewer and contract tests; no padding-byte comparisons. */
+static bool relay_update_pose(struct relay_probe *p, const struct relay_pose *s, double now)
+{
+  const struct relay_pose *a=&p->last;
+  bool changed=!p->have_last || a->x!=s->x || a->y!=s->y || a->iw!=s->iw || a->ih!=s->ih ||
+    a->ww!=s->ww || a->wh!=s->wh || a->bw!=s->bw || a->bh!=s->bh ||
+    a->zoom!=s->zoom || a->rotation!=s->rotation || a->mirror!=s->mirror ||
+    a->focus!=s->focus || a->file_ok!=s->file_ok || a->loading!=s->loading ||
+    a->generation!=s->generation;
+  if (changed || now-p->last_press>=5) relay_reset(p);
+  p->last=*s; p->have_last=true;
+  return changed;
+}
+static bool relay_eligible(const struct relay_probe *p, const struct relay_pose *s)
+{
+  const double *r = p->region;
+  if (!p->configured || !s->focus || !s->file_ok || s->loading ||
+      s->mirror || s->rotation != 0 || !isfinite(s->zoom) ||
+      s->zoom < r[4] || s->zoom > r[5] || s->bw <= 0 || s->bh <= 0 ||
+      r[0]+r[2] > s->iw || r[1]+r[3] > s->ih) return false;
+  double x = s->x + r[0]*s->zoom, y = s->y + r[1]*s->zoom;
+  double w = r[2]*s->zoom, h = r[3]*s->zoom;
+  double visible = fmax(0, fmin(s->bw,x+w)-fmax(0,x)) *
+                   fmax(0, fmin(s->bh,y+h)-fmax(0,y));
+  return visible >= .9*w*h && fabs(x+w/2-s->bw/2.) <= r[6]*s->bw &&
+         fabs(y+h/2-s->bh/2.) <= r[7]*s->bh;
+}
+static void relay_configure(struct relay_probe *p)
+{
+  if (p->initialized) return;
+  p->initialized = true;
+  p->target = getenv("RELAY_IMV_PROBE");
+  const char *spec = getenv("RELAY_IMV_REGION");
+  if (!p->target || !spec) return;
+  char tail;
+  double *r = p->region;
+  if (sscanf(spec,"%lf %lf %lf %lf %lf %lf %lf %lf %c",
+      r,r+1,r+2,r+3,r+4,r+5,r+6,r+7,&tail) != 8) return;
+  for (int i=0;i<8;++i) if (!isfinite(r[i])) return;
+  p->configured = p->target[0]=='/' && r[0]>=0 && r[1]>=0 && r[2]>0 &&
+    r[3]>0 && r[4]>0 && r[5]>=r[4] && r[6]>=0 && r[6]<=1 && r[7]>=0 && r[7]<=1;
+}
+static void relay_feed(struct relay_probe *p, bool eligible, int code, int state, double now)
+{
+  if (!eligible || now-p->last_press >= 5) relay_reset(p);
+  if (!eligible || state != 1) return;
+  p->last_press = now;
+  int candidate[9];
+  unsigned n=p->prefix;
+  memcpy(candidate,relay_sequence,n*sizeof(int));
+  candidate[n++]=code;
+  p->prefix=0;
+  for (unsigned len=n;len>0;--len) {
+    if (!memcmp(candidate+n-len,relay_sequence,len*sizeof(int))) {
+      if (len==8) ++p->matches;
+      else p->prefix=len;
+      return;
+    }
+  }
+}
+#endif
