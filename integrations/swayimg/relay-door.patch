diff --git i/src/relay_probe.hpp w/src/relay_probe.hpp
new file mode 100644
index 0000000..33a4d19
--- /dev/null
+++ w/src/relay_probe.hpp
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: MIT
+// Opt-in viewer-local observation. Presentation only; never authentication.
+#pragma once
+#include <sys/stat.h>
+#include <unistd.h>
+#include <cstdlib>
+#include <filesystem>
+#include <format>
+#include <string>
+
+inline bool relay_probe_enabled() { return std::getenv("RELAY_SWAYIMG_PROBE") || std::getenv("RELAY_SWAYIMG_DOOR"); }
+inline std::string relay_stamp(const struct stat& s)
+{
+    if (!S_ISREG(s.st_mode) || s.st_uid != getuid() || s.st_nlink != 1)
+        return {};
+    return std::format("{}:{}:{}:{}:{}:{}:{}", s.st_dev, s.st_ino, s.st_size,
+                       s.st_mtim.tv_sec, s.st_mtim.tv_nsec,
+                       s.st_ctim.tv_sec, s.st_ctim.tv_nsec);
+}
+struct RelayOrigin {
+    std::string path, stamp;
+    size_t generation = 0;
+    bool original = true;
+    bool current() const {
+        struct stat s;
+        std::error_code ec;
+        const auto canonical = std::filesystem::canonical(path, ec);
+        return original && !stamp.empty() && !ec && canonical == path &&
+            lstat(path.c_str(), &s) == 0 && relay_stamp(s) == stamp;
+    }
+};
